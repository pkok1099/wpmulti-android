<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- C1: foreground service penjaga proxy. POST_NOTIFICATIONS
         dideklarasikan tapi tidak diminta saat runtime: notifikasi FGS
         tetap ditampilkan sistem (exemption) dan prioritas foreground
         tidak bergantung pada izin itu. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Daftar aplikasi lengkap (user + sistem) di Android 11+.
         Aplikasi ini di-sideload langsung, bukan via Play Store.
         Izin install-time (otomatis utk sideload), bukan runtime.
         (Duplikat deklarasi dihapus - hanya satu yang dibutuhkan.) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Package visibility (Android 11+): tanpa ini queryIntentActivities
         hanya mengembalikan segelintir aplikasi. Dengan intent MAIN/LAUNCHER
         ini, daftar aplikasi launcher tampil lengkap (300+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:label="Wpmulti Test"
        android:theme="@style/Theme.WpmultiTest"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true">
        <!-- Fase 1 (targetSdk 36): predictive back diaktifkan di level
             aplikasi. MainActivity menimpanya dengan false eksplisit agar
             perilaku tombol back deterministik: default back = finish
             activity (engine/VPN berjalan di service terpisah).
             TestActivity & VpnControlActivity mewarisi true - keduanya
             tanpa intercept back (noHistory), aman. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|density"
            android:enableOnBackInvokedCallback="false">
            <!-- enableOnBackInvokedCallback="false" dipertahankan agar
                 perilaku tombol back deterministik: default back = finish
                 activity (engine/VPN berjalan di service terpisah). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Test otomatis STOP hang -->
        <activity
            android:name=".TestActivity"
            android:exported="true"
            android:theme="@style/Theme.WpmultiTest.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true" />
        <!-- Kontrol VPN dari luar via am start -->
        <activity
            android:name=".VpnControlActivity"
            android:exported="true"
            android:theme="@style/Theme.WpmultiTest.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true" />
        <service
            android:name=".VpnEngine"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Wajib: VpnEngine kini memanggil startForeground() karena
                 di-start via startForegroundService (tile QS + auto-
                 reconnect dari background). Tanpa tipe ini, targetSdk 34+
                 melempar InvalidForegroundServiceTypeException. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Menjaga koneksi VPN tetap berjalan." />
        </service>
        <!-- C1: keepalive foreground service. Tipe specialUse wajib
             dideklarasikan untuk targetSdk 34+; tidak ada tipe "proxy"
             bawaan sehingga specialUse + subtype adalah pilihan yang jujur.
             Diabaikan aman di API < 34. -->
        <service
            android:name=".VpnTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="Wpmulti VPN"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action
                    android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".ProxyKeepaliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Menjaga proxy lokal tetap berjalan saat aplikasi di background." />
        </service>
        <!-- TAHAP 1 (arsitektur baru): engine WAJIB di proses terpisah
             :goengine. Runtime gomobile hanya hidup di sini; komponen proses
             utama (MainActivity, VpnTileService, VpnControlActivity,
             TestActivity, ProxyKeepaliveService, VpnEngine) mengontrol
             engine lewat AIDL IEngineControl (START/STOP/GET_STATUS/
             GET_DEBUG_MEM) via EngineClient — tidak ada lagi Mobile.* di
             proses utama (dulu: split-brain, engine hantu). TAHAP 3: STOP
             = hard kill proses ini (memori Go kembali ke OS seketika);
             START_NOT_STICKY di onStartCommand; prioritas foreground
             dijaga ProxyKeepaliveService (proses utama). -->
        <service
            android:name=".GoEngineService"
            android:exported="false"
            android:process=":goengine" />
        <!-- foregroundServiceType dihapus: service ini bukan FGS
             (notif prioritas diserahkan ke ProxyKeepaliveService agar
             tidak ada dua notifikasi "berjalan" sekaligus). -->
    </application>
</manifest>
