<?xml version="1.0" encoding="utf-8"?>
<!-- Item tertutup Spinner (cy10): pengganti simple_spinner_item platform
     - tipografi monospace glitch_white. Tanpa padding vertikal agar
     tinggi spinner tertutup tidak bergeser (no layout shift); ellipsize
     END + paddingEnd utk menjauhi panah spinner. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:singleLine="true"
    android:ellipsize="end"
    android:paddingStart="2dp"
    android:paddingEnd="28dp"
    android:gravity="center_vertical"
    android:fontFamily="monospace"
    android:textSize="14sp"
    android:textColor="@color/glitch_white" />
