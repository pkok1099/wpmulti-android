<?xml version="1.0" encoding="utf-8"?>
<!-- Overhaul UI 3/7: Beranda (2/7) + Halaman Sesi komposisi baru.
     Beranda: HeroCard (statusBar + monGo + btnEngine) → Kartu VPN
     (vpnStatus/vpnStats/vpnToggleBtn/pingTestBtn/pingResult) → Kartu
     Monitor (trafficGraph di ATAS angka + headerStats + grid mon*/
     monSesiDetail). Hero pakai bg colorPrimaryContainer (BUKAN colorPrimary)
     agar warna status semantik Java (merah FF5252/amber/hijau) tetap
     terbaca di light+night; teks hero = colorOnPrimaryContainer.
     Sesi: Kartu Profil (totalView + configList + addBtn) → Kartu Proxy
     (proxyTable + proxyStatus) → Kartu Uji Proxy (testUrl di
     TextInputLayout Widget.Wpmulti.TextField + test1Btn/test20Btn +
     testResult + verifyView). Kartu Proxy dipindah dari pageHome
     (kondisi transisi 2/7 selesai); Profil Config dipindah dari
     pageSetting sesuai peta ID plan (Sesi saja — duplikat ID dalam
     1 layout membuat findViewById salah bind).
     Kerangka 1/7 tetap: MaterialToolbar → FrameLayout 4 halaman →
     BottomNavigationView (navHome/navSesi/navLog/navSetelan). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top bar -->
    <com.google.android.material.appbar.MaterialToolbar
        style="@style/Widget.Material3.Toolbar.OnSurface"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:title="wpmulti-test" />

    <!-- Page container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- PAGE: HOME (hero + kartu VPN + kartu Monitor) — semua ID
             tetap ada untuk MainActivity. -->
        <ScrollView android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- HERO: status + subtitle engine + START/STOP -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.HeroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView android:id="@+id/statusBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="BERHENTI"
                            android:drawableStart="@drawable/ic_dot_red"
                            android:drawablePadding="8dp"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView android:id="@+id/monGo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="wpmulti: -"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <Button android:id="@+id/btnEngine"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="12dp"
                            android:text="START"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp"
                            app:iconTint="?attr/colorOnPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KARTU VPN (TUN) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VPN (TUN)"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Route seluruh trafik HP lewat proxy wpmulti (SOCKS5 127.0.0.1:1080). Butuh engine RUNNING."
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView android:id="@+id/vpnStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="VPN (TUN): tidak dipakai"
                            android:textSize="14sp" />
                        <TextView android:id="@+id/vpnStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=""
                            android:textSize="13sp" />

                        <Button android:id="@+id/vpnToggleBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="CONNECT VPN"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp"
                            app:iconTint="?attr/colorPrimary" />
                        <Button android:id="@+id/pingTestBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="TEST PING" />
                        <TextView android:id="@+id/pingResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text=""
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KARTU MONITOR: grafik dulu, baru angka (komposisi baru) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monitor"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.wpmulti.test.TrafficGraphView
                            android:id="@+id/trafficGraph"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_marginTop="8dp" />
                        <TextView android:id="@+id/headerStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:text="RAM: - | CPU: -"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">
                            <TextView android:id="@+id/monRam"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="RAM: -"
                                android:textSize="14sp" />
                            <TextView android:id="@+id/monCpu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="CPU: -"
                                android:textSize="14sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">
                            <TextView android:id="@+id/monCache"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Cache: -"
                                android:textSize="14sp" />
                            <TextView android:id="@+id/monSesi"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Sesi: -"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView android:id="@+id/monSesiDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="12sp"
                            android:typeface="monospace" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- PAGE: SESI — ScrollView kartu vertikal: Profil Config →
             Proxy → Uji Proxy (semua Widget.Wpmulti.Card, margin 8dp) -->
        <ScrollView android:id="@+id/pageSesi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="12dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- KARTU PROFIL CONFIG -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Profil Config"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <TextView android:id="@+id/totalView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="total sesi: 0"
                            android:textSize="14sp" />
                        <LinearLayout android:id="@+id/configList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="4dp" />
                        <Button android:id="@+id/addBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="UPLOAD PROFILE" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Maks 5 profile, 240 sesi per profile"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KARTU PROXY -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Proxy"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <LinearLayout android:id="@+id/proxyTable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="8dp" />
                        <TextView android:id="@+id/proxyStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Proxy SOCKS5/HTTP: tidak aktif"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KARTU UJI PROXY -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Uji Proxy"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Wpmulti.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="URL untuk dites">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/testUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="http://ifconfig.me/ip"
                                android:inputType="textUri" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">
                            <Button android:id="@+id/test1Btn"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="TEST 1x" />
                            <Button android:id="@+id/test20Btn"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="TEST 20x" />
                        </LinearLayout>
                        <TextView android:id="@+id/testResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text=""
                            android:textSize="13sp" />
                        <TextView android:id="@+id/verifyView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="verifikasi: belum dites"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- PAGE: LOG -->
        <LinearLayout android:id="@+id/pageLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <Spinner android:id="@+id/logLevel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <Button android:id="@+id/copyLogBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="COPY" />
                <Button android:id="@+id/clearLogBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="CLEAR" />
            </LinearLayout>
            <EditText android:id="@+id/logFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="filter teks..."
                android:singleLine="true" />
            <ScrollView android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp">
                <TextView android:id="@+id/logView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:typeface="monospace" />
            </ScrollView>
        </LinearLayout>

        <!-- PAGE: SETTING -->
        <ScrollView android:id="@+id/pageSetting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Profil Config (totalView/configList/addBtn) dipindah
                     ke pageSesi di task 3 sesuai peta ID plan — di sini
                     jangan dibuat ulang agar ID tidak duplikat. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Mode DNS"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Spinner android:id="@+id/vpnDnsMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Server DNS"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <EditText android:id="@+id/vpnDnsServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="URL atau IP"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berlaku saat VPN di-connect berikutnya."
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Mode IP"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Spinner android:id="@+id/vpnIpMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bypass = versi IP itu tidak masuk VPN."
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Aplikasi (split tunneling)"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Spinner android:id="@+id/vpnAppMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <Button android:id="@+id/vpnPickAppsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pilih aplikasi..." />
                <TextView android:id="@+id/vpnAppCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum ada aplikasi dipilih"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Mode IP per aplikasi"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Button android:id="@+id/vpnPickIpModeBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pilih mode IP per aplikasi..." />
                <TextView android:id="@+id/vpnIpModeAppCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum ada aplikasi diatur"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hanya berlaku saat Mode IP global = Dual-stack."
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Kill Switch"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <CheckBox android:id="@+id/vpnAutoReconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reconnect otomatis saat VPN putus"
                    android:textSize="14sp"
                    android:checked="true" />
                <Button android:id="@+id/vpnSysSettingsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pengaturan VPN sistem" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proteksi penuh: aktifkan 'Block connections without VPN' di pengaturan sistem."
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Catatan: hanya TCP yang di-relay (IPv4+IPv6). DNS dienkripsi sesuai mode di atas (DoH/DoT/DoQ) atau plain UDP/53. UDP lain &amp; ping ke internet di-drop."
                    android:textSize="12sp"
                    android:paddingBottom="16dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Setting"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp" />
                <TextView android:id="@+id/settingVer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="wpmulti-test"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="4dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Perangkat"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView android:id="@+id/settingDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="13sp"
                    android:padding="4dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Penyimpanan"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView android:id="@+id/settingPaths"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textSize="13sp"
                    android:padding="4dp" />
                <Button android:id="@+id/exportLogBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="EXPORT LOG KE FILE" />
                <Button android:id="@+id/clearCacheBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="HAPUS CACHE" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom navigation: 4 tab -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav"
        app:labelVisibilityMode="labeled" />

</LinearLayout>
