<?xml version="1.0" encoding="utf-8"?>
<!-- Overhaul UI 4/7: halaman Setelan & Log masuk pola kartu.
     Beranda: HeroCard (statusBar + monGo + btnEngine) → Kartu VPN
     (vpnStatus/vpnStats/vpnToggleBtn/pingTestBtn/pingResult) → Kartu
     Monitor (trafficGraph di ATAS angka + headerStats + grid mon*/
     monSesiDetail). Hero pakai bg colorPrimaryContainer (BUKAN colorPrimary)
     agar warna status semantik Java (merah FF5252/amber/hijau) tetap
     terbaca di light+night; teks hero = colorOnPrimaryContainer.
     Sesi: Kartu Profil (totalView + configList + addBtn) → Kartu Proxy
     (proxyTable + proxyStatus) → Kartu Uji Proxy (testUrl di
     TextInputLayout Widget.Wpmulti.TextField + test1Btn/test20Btn +
     testResult + verifyView).
     Setelan (4/7): 2 kartu Widget.Wpmulti.Card — "VPN & Trafik"
     (vpnDnsMode/vpnDnsServer di TextField/vpnIpMode/vpnAppMode/
     vpnPickAppsBtn/vpnAppCount/vpnPickIpModeBtn/vpnIpModeAppCount/
     vpnAutoReconnect/vpnSysSettingsBtn; spinner+checkbox bawaan tema;
     sub-heading bold 14sp; catatan 12sp) → "Aplikasi" (settingVer/
     settingDevice/settingPaths + exportLogBtn/clearCacheBtn).
     Log (4/7): logFilter di TextInputLayout Widget.Wpmulti.TextField;
     copyLogBtn/clearLogBtn OutlinedButton; logLevel/logScroll/logView
     pindahan Task 1 tetap.
     Kerangka 1/7: 4 halaman → BottomNavigationView
     (navHome/navSesi/navLog/navSetelan).
     Fase 2: root jadi FrameLayout; navbar = pill melayang Expressive
     (FloatingToolbarLayout + BNV transparan 64dp) di bottom center.
     Fix pill: konten scroll lewat DI BELAKANG pill sampai tepi bawah
     layar - scroll container pakai clipToPadding=false + clearance bawah
     dinamis (token 104dp + inset nav dari listener rootMain); TIDAK ada
     strip/latar solid di belakang pill, hanya pill itu sendiri yang
     berwarna (translucent 90% + elevation lib 6dp). Inset tetap SEKALI
     di listener rootMain.
     Hotfix: MaterialToolbar placeholder (56dp, judul saja, tanpa id &
     tanpa rujukan Java) DIHAPUS - navigasi sudah ditangani bottom nav.
     Konten pertama kini mulai 12dp di bawah status bar (inset system
     bars diterapkan SEKALI di listener rootMain, MainActivity). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Page container: mengisi seluruh frame SAMPAI TEPI BAWAH layar;
         pill navbar melayang DI ATAS konten (bottom|center). Scroll
         container halaman pakai clipToPadding=false + clearance bawah
         supaya konten lewat DI BELAKANG pill saat discroll (item
         terakhir tetap bisa digeser ke atas pill). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- PAGE: HOME (hero + kartu VPN + kartu Monitor) — semua ID
             tetap ada untuk MainActivity. -->
        <ScrollView android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="@dimen/nav_pill_clearance">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- HERO: status + subtitle engine + START/STOP -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.HeroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView android:id="@+id/statusBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="BERHENTI"
                            android:drawableStart="@drawable/ic_dot_red"
                            android:drawablePadding="8dp"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <TextView android:id="@+id/monGo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="wpmulti: -"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <!-- Fase 4: LoadingIndicator (widget Expressive
                             material 1.14.0) saat MEMULAI/MENGHENTIKAN;
                             visibility diatur dari Java. -->
                        <com.google.android.material.loadingindicator.LoadingIndicator
                            android:id="@+id/heroLoading"
                            style="@style/Widget.Material3.LoadingIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"
                            app:indicatorColor="?attr/colorOnPrimaryContainer"
                            app:indicatorSize="24dp" />

                        <Button android:id="@+id/btnEngine"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="12dp"
                            android:text="START"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp"
                            app:iconTint="?attr/colorOnPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Glitchcore: pembatas scanline dashed (cyan 30%) -
                     penanda ritme HUD antara hero dan kartu VPN; 2dp agar
                     dash di tengah bounds tidak terpotong, software layer
                     demi render dash konsisten di hardware accel. -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/divider_scanline"
                    android:layerType="software" />

                <!-- KARTU VPN (TUN) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VPN (TUN)"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Route seluruh trafik HP lewat proxy wpmulti (SOCKS5 127.0.0.1:1080). Butuh engine RUNNING."
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView android:id="@+id/vpnStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="VPN (TUN): tidak dipakai"
                            android:textSize="14sp" />
                        <TextView android:id="@+id/vpnStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=""
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <Button android:id="@+id/vpnToggleBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="CONNECT VPN"
                            app:icon="@drawable/ic_play"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp"
                            app:iconTint="?attr/colorPrimary" />
                        <Button android:id="@+id/pingTestBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="TEST PING" />
                        <TextView android:id="@+id/pingResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text=""
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KARTU MONITOR: grafik dulu, baru angka (komposisi baru) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monitor"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.wpmulti.test.TrafficGraphView
                            android:id="@+id/trafficGraph"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_marginTop="8dp" />
                        <TextView android:id="@+id/headerStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="4dp"
                            android:text="RAM: - | CPU: -"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Fase 3: throughput = angka besar (TitleLarge)
                             + total kecil, per arah (RX kiri, TX kanan).
                             Pengganti baris teks panjang "sesi aktif: N |
                             TX 0 B (0 B/s) | RX ..." yang terpotong di
                             grid lama. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="RX (turun)"
                                    android:textSize="12sp"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                                <TextView android:id="@+id/monRx"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-"
                                    android:fontFamily="monospace"
                                    android:textAppearance="?attr/textAppearanceTitleLarge" />
                                <TextView android:id="@+id/monRxTotal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="total -"
                                    android:textSize="12sp"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="TX (naik)"
                                    android:textSize="12sp"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                                <TextView android:id="@+id/monTx"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-"
                                    android:fontFamily="monospace"
                                    android:textAppearance="?attr/textAppearanceTitleLarge" />
                                <TextView android:id="@+id/monTxTotal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="total -"
                                    android:textSize="12sp"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">
                            <TextView android:id="@+id/monRam"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="RAM: -"
                                android:textSize="14sp" />
                            <TextView android:id="@+id/monCpu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="CPU: -"
                                android:textSize="14sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">
                            <TextView android:id="@+id/monCache"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Cache: -"
                                android:textSize="14sp" />
                            <TextView android:id="@+id/monSesi"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Sesi: -"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Fase 3: daftar sesi jadi CHIP (dot warna status
                             + detail saat disentuh) - pengganti satu TextView
                             monospace "#0 hs=- tx=0 B rx=0 B" per sesi yang
                             teksnya menumpuk & terpotong. Isi diatur Java
                             (rebuildSessionChips, update in-place). -->
                        <LinearLayout android:id="@+id/monSesiDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- PAGE: SESI — ScrollView kartu vertikal: Profil Config →
             Proxy → Uji Proxy (semua Widget.Wpmulti.Card, margin 8dp) -->
        <ScrollView android:id="@+id/pageSesi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="@dimen/nav_pill_clearance"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- KARTU PROFIL CONFIG -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Profil Config"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <TextView android:id="@+id/totalView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="total sesi: 0"
                            android:textSize="14sp" />
                        <LinearLayout android:id="@+id/configList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="4dp" />
                        <Button android:id="@+id/addBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="UPLOAD PROFILE" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Maks 5 profile, 240 sesi per profile"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KARTU PROXY -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Proxy"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <LinearLayout android:id="@+id/proxyTable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="8dp" />
                        <TextView android:id="@+id/proxyStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Proxy SOCKS5/HTTP: tidak aktif"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KARTU UJI PROXY -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Uji Proxy"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Wpmulti.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="URL untuk dites">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/testUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="http://ifconfig.me/ip"
                                android:inputType="textUri" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">
                            <Button android:id="@+id/test1Btn"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="TEST 1x" />
                            <Button android:id="@+id/test20Btn"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="TEST 20x" />
                        </LinearLayout>
                        <TextView android:id="@+id/testResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text=""
                            android:textSize="13sp" />
                        <TextView android:id="@+id/verifyView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="verifikasi: belum dites"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- PAGE: LOG - clearance bawah pindah ke logScroll (scroll
             container dalam) supaya baris log terakhir lewat di belakang
             pill; container luar tidak lagi memotong area konten. -->
        <LinearLayout android:id="@+id/pageLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <Spinner android:id="@+id/logLevel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <Button android:id="@+id/copyLogBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="COPY" />
                <Button android:id="@+id/clearLogBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="CLEAR" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Wpmulti.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="filter teks...">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/logFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <ScrollView android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/nav_pill_clearance">
                <TextView android:id="@+id/logView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:typeface="monospace" />
            </ScrollView>
        </LinearLayout>

        <!-- PAGE: SETTING — 2 kartu Widget.Wpmulti.Card (margin antar
             kartu 8dp): "VPN & Trafik" lalu "Aplikasi". Spinner & CheckBox
             bawaan tema (tidak dibungkus style custom); sub-heading dalam
             kartu bold 14sp; catatan 12sp tidak diubah isinya.
             Profil Config (totalView/configList/addBtn) tetap di pageSesi
             (task 3 sesuai peta ID plan) — jangan dibuat ulang di sini agar
             ID tidak duplikat. -->
        <ScrollView android:id="@+id/pageSetting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="@dimen/nav_pill_clearance"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- KARTU VPN & TRAFIK -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VPN &amp; Trafik"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mode DNS"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <Spinner android:id="@+id/vpnDnsMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Server DNS"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Wpmulti.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:hint="URL atau IP">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/vpnDnsServer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Berlaku saat VPN di-connect berikutnya."
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Mode IP"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <Spinner android:id="@+id/vpnIpMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Bypass = versi IP itu tidak masuk VPN."
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Aplikasi (split tunneling)"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <Spinner android:id="@+id/vpnAppMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <Button android:id="@+id/vpnPickAppsBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pilih aplikasi..." />
                        <TextView android:id="@+id/vpnAppCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Belum ada aplikasi dipilih"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Mode IP per aplikasi"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <Button android:id="@+id/vpnPickIpModeBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pilih mode IP per aplikasi..." />
                        <TextView android:id="@+id/vpnIpModeAppCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Belum ada aplikasi diatur"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Hanya berlaku saat Mode IP global = Dual-stack."
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Kill Switch"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <CheckBox android:id="@+id/vpnAutoReconnect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Reconnect otomatis saat VPN putus"
                            android:textSize="14sp"
                            android:checked="true" />
                        <Button android:id="@+id/vpnSysSettingsBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pengaturan VPN sistem" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Proteksi penuh: aktifkan 'Block connections without VPN' di pengaturan sistem."
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Catatan: hanya TCP yang di-relay (IPv4+IPv6). DNS dienkripsi sesuai mode di atas (DoH/DoT/DoQ) atau plain UDP/53. UDP lain &amp; ping ke internet di-drop."
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KARTU APLIKASI -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Wpmulti.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aplikasi"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />
                        <TextView android:id="@+id/settingVer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="wpmulti-test"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Perangkat"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/settingDevice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="-"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Penyimpanan"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView android:id="@+id/settingPaths"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="-"
                            android:textSize="13sp" />
                        <Button android:id="@+id/exportLogBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="EXPORT LOG KE FILE" />
                        <Button android:id="@+id/clearCacheBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="HAPUS CACHE" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Navbar pill melayang (M3 Expressive): FloatingToolbarLayout dari
         material 1.14.0 - container pill full-round (ShapeAppearance.M3.
         Comp.Toolbar.Floating.Container.Shape = Corner.Full 50%, referensi
         style tetap lib, TIDAK terpengaruh remap shapeCornerSize* tema).
         Fix: TIDAK ada strip/latar di belakang pill - hanya pill itu
         sendiri yang berwarna, sedikit translucent (nav_pill_container)
         + elevation lib 6dp sebagai shadow lembut; konten halaman lewat
         di belakangnya sampai tepi bawah layar. Margin bawah base 12dp
         ditimpa listener rootMain = inset nav + 4dp (aman gesture nav).
         CATATAN inset: listener rootMain mengembalikan CONSUMED sehingga
         attr *SystemWindowInsets milik lib no-op; inset sepenuhnya di
         listener rootMain (bukan lib). -->
    <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
        style="@style/Widget.Material3.FloatingToolbar"
        android:id="@+id/navPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:backgroundTint="@color/nav_pill_container">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            style="@style/Widget.Wpmulti.Nav"
            android:id="@+id/bottomNav"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:backgroundTint="@android:color/transparent"
            android:elevation="0dp"
            app:menu="@menu/bottom_nav"
            app:labelVisibilityMode="labeled" />
    </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>

</FrameLayout>
