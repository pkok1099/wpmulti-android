<?xml version="1.0" encoding="utf-8"?>
<!-- Overhaul UI 3/7: baris proxy = kartu mungil (Widget.Wpmulti.Card
     contentPadding 4dp, elevation 0, margin bawah 4dp). proxyName medium,
     proxyAddr monospace, proxyStatus warna diset Java (JANGAN set
     textColor di sini), proxyCopy = IconButton ic_content_copy.
     ID SEMUA TETAP (proxyName/proxyAddr/proxyStatus/proxyCopy) — row
     di-inflate ke proxyTable (pageSesi). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Wpmulti.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    app:cardElevation="0dp"
    app:contentPadding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/proxyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="SOCKS5" />

        <TextView
            android:id="@+id/proxyAddr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:typeface="monospace"
            android:text="127.0.0.1:1080" />

        <TextView
            android:id="@+id/proxyStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp" android:paddingRight="8dp"
            android:text="-" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/proxyCopy"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_content_copy"
            app:iconTint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
