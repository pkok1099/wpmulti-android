<?xml version="1.0" encoding="utf-8"?>
<!-- Overhaul UI 3/7: baris config = kartu mungil (Widget.Wpmulti.Card
     contentPadding 4dp, elevation 0, margin bawah 4dp). minus/plus/del =
     IconButton ikon (ic_minus/ic_plus/ic_close, tint onSurfaceVariant),
     max = OutlinedButton, count = EditText number center.
     ID SEMUA TETAP (label/minus/count/plus/max/del) — MainActivity
     mengakses via row.findViewById; row di-inflate ke configList
     (pageSesi). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Wpmulti.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    app:cardElevation="0dp"
    app:contentPadding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="profile" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/minus"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_minus"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/count"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:gravity="center"
            android:text="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/plus"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_plus"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/max"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAX" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/del"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@drawable/ic_close"
            app:iconTint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
