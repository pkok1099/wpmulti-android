<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme utama: Material 3 Expressive - DARK-ONLY (tema "Cybercore").
         Varian Light + values-night/ dihapus: identitas cybercore memang
         gelap, satu sumber palet di values/colors.xml untuk semua
         konfigurasi. Sudut dijaga TEGAS via token 4/6/8dp (dimens.xml)
         - default M3E (4-48dp) sengaja TIDAK dipakai agar tidak terlalu
         round. -->
    <style name="Theme.WpmultiTest" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <!-- Palet "Cybercore": kanvas near-black biru #0B1119, aksen neon
             cyan #22D3EE + magenta #F0ABFC. Detail + kontras di
             colors.xml. -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <!-- Sekunder diremap GLOBAL lagi (keputusan review lama di-scope
             ke nav karena palet Orkid ingin dibatasi; pada cybercore
             container sekunder ber-tona cyan justru identitas global:
             TonalButton/Switch/Chip/CheckBox ikut neon). -->
        <item name="colorSecondaryContainer">@color/m3_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="android:colorBackground">@color/m3_surface</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_high</item>
        <!-- Sweep cy3: seluruh keluarga surfaceContainer (dulu default
             neutral gray lib) -> tangga near-black biru cybercore. -->
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceDim">@color/m3_surface_dim</item>
        <item name="colorSurfaceBright">@color/m3_surface_bright</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <!-- Overscroll glow cyan (bukan default abu-abu). -->
        <item name="android:colorEdgeEffect">@color/glitch_scan</item>
        <!-- Ripple cybercore (cy10): sentuhan/pressed di semua komponen
             (termasuk baris list dialog & item dropdown) berkilat cyan
             15%, bukan abu-abu netral bawaan. -->
        <item name="android:colorControlHighlight">@color/glitch_ripple</item>
        <!-- Scrollbar cybercore (cy10): thumb cyan tipis utk semua
             ScrollView/ListView yang memakai default (log, list dialog). -->
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_cyber</item>
        <!-- SEMUA dialog framework (android.app.AlertDialog) satu sumber
             tema (cy10): panel cybercore + stroke neon + tipografi
             monospace + kontrol bertema - didefinisikan sekali di sini,
             bukan per komponen. -->
        <item name="android:alertDialogTheme">@style/Theme.WpmultiTest.Dialog</item>
        <!-- Snackbar (defensif): kalaupun dipakai nanti, tetap cyber,
             tidak memakai inverseSurface terang bawaan M3. -->
        <item name="snackbarStyle">@style/Widget.Wpmulti.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.Wpmulti.Snackbar.TextView</item>

        <!-- Tombol default tonal - kini ber-tona cyan container (cybercore)
             hierarki primary tetap bisa ditambah eksplisit nanti -->
        <item name="materialButtonStyle">@style/Widget.Material3.Button.TonalButton</item>

        <!-- SUDUT TEGAS lapis 1: 3 attr komponen klasik (tonal button,
             textfield, chip, card membaca ini). Default lib = literal
             4/8/16dp - diganti token app. -->
        <item name="shapeAppearanceSmallComponent">@style/Shape.Wpmulti.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Wpmulti.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.Wpmulti.Large</item>

        <!-- SUDUT TEGAS lapis 2: token sistem Expressive (shapeCornerSize*)
             untuk widget Expressive. Default lib: 4/8/12/16/20/28/32/48dp
             -> semua dipetakan ke skala 4/6/8. -->
        <item name="shapeCornerSizeExtraSmall">@dimen/corner_small</item>
        <item name="shapeCornerSizeSmall">@dimen/corner_small</item>
        <item name="shapeCornerSizeMedium">@dimen/corner_medium</item>
        <item name="shapeCornerSizeLarge">@dimen/corner_large</item>
        <item name="shapeCornerSizeLargeIncreased">@dimen/corner_large</item>
        <item name="shapeCornerSizeExtraLarge">@dimen/corner_large</item>
        <item name="shapeCornerSizeExtraLargeIncreased">@dimen/corner_large</item>
        <item name="shapeCornerSizeExtraExtraLarge">@dimen/corner_large</item>
    </style>

    <!-- Varian translucent utk VpnControlActivity & TestActivity
         (pengganti android:Theme.Translucent.NoTitleBar - wajib turunan
         AppCompat karena activity sudah AppCompatActivity). Parent implisit
         = Theme.WpmultiTest sehingga override M3E + sudut ikut. -->
    <style name="Theme.WpmultiTest.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- Shape app: rounded keluarga, ukuran dari token dimens.xml -->
    <style name="Shape.Wpmulti.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_small</item>
    </style>
    <style name="Shape.Wpmulti.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_medium</item>
    </style>
    <style name="Shape.Wpmulti.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_large</item>
    </style>

    <!-- Kartu fungsional (dipakai Beranda task 2, lalu Sesi/Setelan task
         3/4): elevated + sudut token besar + surface_container_high.
         Warna via @color resource -> dark-only dari values/colors.xml. -->
    <style name="Widget.Wpmulti.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/Shape.Wpmulti.Large</item>
        <item name="cardBackgroundColor">@color/m3_surface_container_high</item>
        <item name="contentPadding">12dp</item>
    </style>

    <!-- TextField OutlinedBox sudut tegas (dipakai testUrl task 3,
         logFilter task 4): OutlinedBox + Shape.Wpmulti.Small (token 4dp). -->
    <style name="Widget.Wpmulti.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/Shape.Wpmulti.Small</item>
    </style>

    <!-- Kartu hero Beranda: bg colorPrimaryContainer (#00404F deep teal)
         (BUKAN colorPrimary) agar warna status semantik yang di-set Java
         (merah/amber/hijau pada statusBar) tetap terbaca di kanvas gelap.
         Sekarang redundan dengan remap global, dipertahankan eksplisit. -->
    <style name="Widget.Wpmulti.HeroCard" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/Shape.Wpmulti.Large</item>
        <item name="cardBackgroundColor">@color/m3_primary_container</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- (cy10.4) Widget.Wpmulti.Nav + ThemeOverlay.Wpmulti.NavPill DIHAPUS:
         dipakai BottomNavigationView yang kini diganti CyberNavBar (view
         framework polos). Warna item/indikator navbar kini eksplisit di
         res/color/nav_item_{icon,text}_tint.xml + bg_nav_indicator.xml —
         nilai identik dengan mapping era overlay (aktif =
         m3_on_primary_container, nonaktif = m3_on_surface_variant). -->

    <!-- cy10.3: label item nav COMPACT - 11sp satu ukuran utk aktif &
         non-aktif (aktif dibedakan indikator pill + warna ikon/teks
         selector, bukan ukuran teks) -> tinggi item stabil saat pindah
         tab, tidak ada "lompatan" label. cy10.4: dipakai CyberNavBar. -->
    <style name="TextAppearance.Wpmulti.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Glitch window/popup animation (cy7): dialog & dropdown MUNCUL dan
         HILANG karena glitch - flicker alpha multi-langkah + micro scale
         (bukan fade/slide platform). Dipasang via
         Window.setWindowAnimations / PopupWindow.setAnimationStyle HANYA
         saat animScale > 0 (aksesibilitas: animasi 0 = tanpa efek).
         Keuntungan window-level: seluruh panel dialog/popup yang berubah
         dianimasikan, background aplikasi TIDAK tersentuh. -->
    <style name="GlitchWindowAnim">
        <item name="android:windowEnterAnimation">@anim/glitch_materialize</item>
        <item name="android:windowExitAnimation">@anim/glitch_disintegrate</item>
    </style>
    <style name="GlitchPopupWindow">
        <item name="android:windowEnterAnimation">@anim/glitch_materialize</item>
        <item name="android:windowExitAnimation">@anim/glitch_disintegrate</item>
    </style>

    <!-- Varian MATI (cy10): 0-duration - dipakai saat efek glitch
         dimatikan (mode Mati / AUTO + animator sistem 0) supaya window
         dialog/popup muncul & tertutup SEKETIKA, bukan fade platform
         default. Aman utk animator scale 0 (animasi window tidak
         pernah dibaca dari callback Animator). -->
    <style name="GlitchWindowAnimOff">
        <item name="android:windowEnterAnimation">@anim/none</item>
        <item name="android:windowExitAnimation">@anim/none</item>
    </style>
    <style name="GlitchPopupWindowOff">
        <item name="android:windowEnterAnimation">@anim/none</item>
        <item name="android:windowExitAnimation">@anim/none</item>
    </style>

    <!-- Snackbar cyber (defensif cy3): container near-black biru + teks
         monospace cyan muda. Tidak dipakai kode saat ini (notif lewat HUD
         in-app), tapi style disiapkan agar tak pernah muncul box terang
         default M3. -->
    <style name="Widget.Wpmulti.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/m3_surface_container_high</item>
        <item name="elevation">6dp</item>
    </style>
    <style name="Widget.Wpmulti.Snackbar.TextView" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/m3_on_primary_container</item>
        <item name="android:typeface">monospace</item>
    </style>

    <!-- ================== THEME DIALOG CYBERCORE (cy10) ==================
         SATU DialogTheme utk SEMUA dialog (loading "Memuat daftar
         aplikasi", "Pilih aplikasi" / split tunnel, "Mode IP per
         aplikasi", dan dialog framework lain dari halaman mana pun):
         dipasang SEKALI via android:alertDialogTheme di Theme.WpmultiTest
         + ContextThemeWrapper (dialogCtx()) utk widget yang dibuat
         programatis DI DALAM dialog (EditText search, CheckBox baris
         aplikasi, Button mode IP, ListView) karena widget-widget itu
         tidak di-inflate dari XML layout dialog.
         Framework-based (android.*) - cocok dgn android.app.AlertDialog
         yang dipakai MainActivity. -->
    <style name="Theme.WpmultiTest.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <!-- Panel gelap OPAQUE + border neon tipis + sudut tegas 8dp. -->
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <!-- Aksen: cyan (tombol aksi, kursor, kontrol aktif). -->
        <item name="android:colorAccent">@color/m3_primary</item>
        <item name="android:colorControlActivated">@color/m3_primary</item>
        <item name="android:colorControlHighlight">@color/glitch_ripple</item>
        <!-- Tipografi & warna teks: sama dgn halaman utama. -->
        <item name="android:textColorPrimary">@color/glitch_white</item>
        <item name="android:textColorSecondary">@color/m3_on_surface_variant</item>
        <item name="android:textColorAlertDialogListItem">@color/glitch_white</item>
        <item name="android:windowTitleStyle">@style/Widget.Wpmulti.DialogWindowTitle</item>
        <!-- Tombol aksi dialog (BATAL/OK/TUTUP): borderless cyan mono. -->
        <item name="android:buttonBarButtonStyle">@style/Widget.Wpmulti.DialogButton</item>
        <!-- Search field: terminal/HUD (garis neon, cursor cyan jelas). -->
        <item name="android:editTextStyle">@style/Widget.Wpmulti.EditText.Terminal</item>
        <!-- Checkbox baris aplikasi: drawable cyber custom. -->
        <item name="android:checkboxStyle">@style/Widget.Wpmulti.CheckBox</item>
        <!-- Tombol programatis di dalam dialog (chip mode IP): default
             framework Button -> chip neon flat (varian warna oleh kode
             karena berbeda PER MODE: GLOBAL/IPv4/IPv6). Tombol aksi
             framework tetap DialogButton via buttonBarButtonStyle
             eksplisit di layout internal dialog. -->
        <item name="android:buttonStyle">@style/Widget.Wpmulti.ModeChip</item>
        <!-- Divider & scrollbar & list item color mengikuti tema. -->
        <item name="android:listDivider">@drawable/divider_scanline</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_cyber</item>
    </style>

    <!-- Judul dialog: monospace bold + tracking - identik bahasa
         tipografi halaman utama (statusBar/HUD). (Parentless: style
         framework DialogWindowTitle tidak publik; semua item eksplisit.) -->
    <style name="Widget.Wpmulti.DialogWindowTitle" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Wpmulti.DialogTitle</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:minHeight">44dp</item>
    </style>
    <style name="TextAppearance.Wpmulti.DialogTitle" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/glitch_white</item>
    </style>

    <!-- Tombol aksi dialog: konsisten dgn bahasa tombol aplikasi
         (monospace bold tracking, cyan; pressed menyala putih). -->
    <style name="Widget.Wpmulti.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dialog_btn_text</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <!-- Search field terminal/HUD: kotak near-black + garis neon,
         cursor cyan tebal, seleksi cyan 18%. -->
    <style name="Widget.Wpmulti.EditText.Terminal" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/bg_search_terminal</item>
        <item name="android:textColor">@color/glitch_white</item>
        <item name="android:textColorHint">@color/m3_on_surface_variant</item>
        <item name="android:textCursorDrawable">@drawable/cursor_cyber</item>
        <item name="android:textColorHighlight">#2E22D3EE</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">10dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- Checkbox cybercore: kotak tegas + check cyan. Terhubung dgn
         glitch checked/unchecked (listener row sudah memanggil
         glitchNow MINOR + jitter - tidak berubah). -->
    <style name="Widget.Wpmulti.CheckBox" parent="android:Widget.Material.CompoundButton.CheckBox">
        <item name="android:button">@drawable/cb_cyber</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/glitch_white</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <!-- Chip mode IP per aplikasi (tombol GLOBAL/IPv4/IPv6): label
         neon flat TANPA shadow framework (stateListAnimator null,
         elevation 0). Warna per mode dipasang kode (applyModeChipStyle):
         bg + textColor dari token yang sama.
         cy10.3: minHeight 30 -> 48dp (area sentuh minimal 48dp -
         permintaan eksplisit; minWidth 68dp sudah >= 48dp). -->
    <style name="Widget.Wpmulti.ModeChip" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_chip_mode_global</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">68dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/m3_on_surface_variant</item>
    </style>
</resources>
