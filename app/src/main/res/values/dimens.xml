<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Token sudut M3 Expressive: skala KOTAK (sudut round kecil, tegas
         & elegan). v1.7 = 6/10/14 masih terlalu round menurut user ->
         v1.8 dipangkas ke 4/6/8. Dipakai Shape.Wpmulti.* (lapis 1) dan
         token shapeCornerSize* tema (lapis 2). -->
    <dimen name="corner_small">4dp</dimen>
    <dimen name="corner_medium">6dp</dimen>
    <dimen name="corner_large">8dp</dimen>

    <!-- Fix pill melayang: clearance BAWAH base container scroll (tinggi
         pill + margin + ruang napas). Inset navigation bar DITAMBAH
         dinamis oleh listener rootMain (base + bars.bottom) sehingga item
         terakhir tetap bisa digeser ke atas pill di perangkat gesture nav
         maupun 3-button. Dengan clipToPadding=false di scroll container,
         konten tetap lewat di belakang pill - bukan dipotong.
         cy10.3: pill compact 64dp (dari 80dp) -> clearance 88dp. -->
    <dimen name="nav_pill_clearance">88dp</dimen>
</resources>
