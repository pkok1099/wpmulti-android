<?xml version="1.0" encoding="utf-8"?>
<!-- cy10.4: indikator item aktif navbar — SATU view terpisah di dalam
     pill (CyberNavBar), bukan bagian dari item. Capsule penuh: radius 16dp
     = setengah tinggi 32dp. Warna = m3_primary_container (identik warna
     indikator aktif era BNV via ThemeOverlay.Wpmulti.NavPill — mapping
     colorSecondaryContainer -> m3_primary_container). GradientDrawable XML
     polos; TANPA elevation/shadow/overlay apa pun. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/m3_primary_container" />
    <corners android:radius="16dp" />
</shape>
