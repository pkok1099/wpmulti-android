<!-- cy10.3: latar pill nav melayang - pengganti MaterialShapeDrawable
     FloatingToolbarLayout. GradientDrawable XML polos: capsule penuh
     (radius = 32dp = setengah tinggi pill 64dp -> sisi melengkung
     sempurna), warna nav_pill_container (90% alpha, konten lewat samar
     di belakang). ELEVASI TETAP 0 (dipasang di layout): tanpa shadow
     framework -> tidak ada outline/shadow/layer yang bisa pecah jadi
     kotak (lihat docs/KNOWN_ISSUES.md - akar artifact tepi pill). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nav_pill_container" />
    <corners android:radius="32dp" />
</shape>
