<?xml version="1.0" encoding="utf-8"?>
<!-- Latar dialog cybercore (cy10): panel near-black biru OPAQUE (teks di
     belakang tidak tembus) + stroke neon cyan tipis 1dp + sudut token
     corner_large (8dp, tegas - konsisten dgn kartu aplikasi). Dipakai
     sebagai android:windowBackground Theme.WpmultiTest.Dialog - SATU
     sumber utk semua dialog (loading, Pilih aplikasi, Mode IP per
     aplikasi, dan dialog framework lain). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dialog_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/dialog_stroke" />
    <corners android:radius="@dimen/corner_large" />
</shape>
