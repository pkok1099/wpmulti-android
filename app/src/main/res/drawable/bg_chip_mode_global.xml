<?xml version="1.0" encoding="utf-8"?>
<!-- Chip mode IP (cy10) - GLOBAL (netral): label neon dim. Pressed =
     stroke menyala. Dipasang Widget.Wpmulti.ModeChip (default); varian
     warna per mode dipilih kode (applyModeChipStyle) - satu gaya,
     tiga palet: GLOBAL slate, IPv4 cyan, IPv6 magenta. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_global_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/m3_on_surface_variant" />
            <corners android:radius="@dimen/corner_small" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_global_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/m3_outline" />
            <corners android:radius="@dimen/corner_small" />
        </shape>
    </item>
</selector>
