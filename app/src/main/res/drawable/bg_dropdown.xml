<?xml version="1.0" encoding="utf-8"?>
<!-- Latar dropdown glitch (cy7): near-black biru cybercore + stroke
     neon cyan 1dp + sudut token 10dp - konsisten dgn kartu aplikasi.
     Dipakai GlitchDropdown (ListView popup) sebagai background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glitch_dropdown_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/m3_primary" />
    <corners android:radius="10dp" />
</shape>
