<?xml version="1.0" encoding="utf-8"?>
<!-- Chip mode IP (cy10.7) - BLOCK v6: merah (status_red - merah glitch
     yang sama dgn sisi R chromatic aberration). Pressed = stroke
     menyala. Pola identik dgn varian v4/v6/global; wash 15% + stroke
     1dp. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_block6_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/glitch_white" />
            <corners android:radius="@dimen/corner_small" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_block6_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/status_red" />
            <corners android:radius="@dimen/corner_small" />
        </shape>
    </item>
</selector>
