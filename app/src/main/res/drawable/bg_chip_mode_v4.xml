<?xml version="1.0" encoding="utf-8"?>
<!-- Chip mode IP (cy10) - IPv4 BYPASS: neon cyan. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_v4_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/glitch_white" />
            <corners android:radius="@dimen/corner_small" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_v4_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/m3_primary" />
            <corners android:radius="@dimen/corner_small" />
        </shape>
    </item>
</selector>
