<?xml version="1.0" encoding="utf-8"?>
<!-- Glitchcore: pembatas "scanline" - garis dashed cyan 30%, bahasa
     HUD/datastream di antara kartu hero dan kartu VPN. Pakai shape line
     bawaan framework (tanpa custom view/blur); view pemakainya 2dp agar
     dash di tengah bounds tidak terpotong, plus layerType software demi
     render dash yang konsisten. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="line">
    <stroke
        android:width="1dp"
        android:color="@color/glitch_scan"
        android:dashWidth="6dp"
        android:dashGap="4dp" />
</shape>
