<?xml version="1.0" encoding="utf-8"?>
<!-- Glitchcore: latar HUD notifikasi in-app (pengganti Toast sistem yang
     tampil sbg box abu-abu default). Glassy dark + stroke neon cyan 40%,
     sudut token SMALL 4dp (disiplin 4/6/8). Dipakai TextView hudToast di
     activity_main.xml, posisi di atas pill nav. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="4dp" />
    <solid android:color="@color/nav_pill_container" />
    <stroke
        android:width="1dp"
        android:color="@color/glitch_scan" />
</shape>
