<?xml version="1.0" encoding="utf-8"?>
<!-- Search field terminal/HUD (cy10): kotak near-black pekat + garis
     neon cyan 1dp + sudut 3dp - dipakai style Widget.Wpmulti.EditText
     .Terminal (search "Cari aplikasi..." di dialog). Kontras teks &
     hint dijaga oleh token warna di colors.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/field_terminal_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/dialog_stroke" />
    <corners android:radius="3dp" />
</shape>
